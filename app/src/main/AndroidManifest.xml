<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- miuix-blur 声明 minSdk 33（AGSL RuntimeShader 需要）；本 App minSdk 29 兼容面不砍——
         overrideLibrary 强接，其 blur 能力一律 SDK_INT >= 33 守卫后才用，
         低版本继续走自有 BackdropBlur/SheetBackdrop 管线（31 以下自动回退压暗）。 -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- PackageInstaller Session API 安装自更新 APK 必需；未声明时 createSession/commit 抛 SecurityException（曾于 v0.5.7 误删致「无法调起安装器」） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- allowBackup 必须 false：系统备份会带走 DataStore（含 KeyStore 包裹的库密钥密文）与 SQLCipher 库文件，
         但 AndroidKeyStore 主密钥设备绑定、不随备份迁移——云恢复后密文必解不开，曾致启动崩溃死循环
         （13 文档 B2-01；DbKeyManager 有换钥+旧库隔离兜底，但数据视同丢失）。应用内自有 WebDAV/S3 备份体系。 -->
    <!-- ⚠️ 本仓返回拦截一律用 androidx BackHandler（不得用已废弃的 onBackPressed 重写）：
         将来若要开 android:enableOnBackInvokedCallback，这一点已兼容。 -->
    <application
        android:name=".JiabanApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MdJiaban">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 头像裁剪：CanHub CropImageActivity 是 AppCompatActivity，用 decor ActionBar 承载裁剪菜单按钮，必须用带 ActionBar 的 AppCompat 主题（NoActionBar 会导致无按钮） -->
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:theme="@style/Theme.AppCompat.DayNight" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <receiver
        android:name=".core.update.InstallResultReceiver"
        android:exported="false" />

</application>

</manifest>
