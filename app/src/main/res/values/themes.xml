<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MdJiaban" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- 保持与库原样一致（避免重名覆盖时丢项）；decorFitsSystemWindows=true 的弹窗用它 -->
    <style name="DialogWindowTheme">
        <item name="android:windowClipToOutline">false</item>
        <!-- 还剩的 Dialog 窗口是铺满屏的内容窗（头像裁剪）：窗口动画一律关——从下往上推入的
             默认动画对铺满屏的窗只会表现为整页滑动，没有意义 -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>
</resources>
